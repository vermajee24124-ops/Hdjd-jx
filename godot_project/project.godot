[application]
config/name="AI Power Game Factory"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/version="1.0.0"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)

[android]
package/unique_name="com.aipowergame.factory"
package/name="AI Power Game Factory"
permissions/internet=true
